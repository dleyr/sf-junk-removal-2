# This site works out of the box with NO environment variables and
# NO build step. This file only matters if you add optional
# integrations later.
#
# Nothing here is read automatically by the plain HTML/CSS/JS site —
# it's documentation for the values you'd need if you wire up one of
# the integrations below. See README.md for full instructions.

# --- Contact form (only needed if NOT using Netlify Forms) ---------
# If you deploy somewhere other than Netlify and want to use a
# service like Formspree instead, put your form endpoint URL here
# and copy it into js/content.js -> form.formEndpoint, then set
# form.useNetlifyForms to false.
FORM_ENDPOINT=https://formspree.io/f/your-form-id

# --- Analytics (optional, not included by default) -----------------
# ANALYTICS_ID=

# --- Maps / Places (optional, not included by default) -------------
# MAPS_API_KEY=
